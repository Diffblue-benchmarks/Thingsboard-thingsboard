<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.thingsboard.common</groupId>
        <version>3.9.0-SNAPSHOT</version>
        <artifactId>transport</artifactId>
    </parent>
    <groupId>org.thingsboard.common.transport</groupId>
    <artifactId>mqtt</artifactId>
    <packaging>jar</packaging>

    <name>Thingsboard MQTT Transport Common</name>
    <url>https://thingsboard.io</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <main.dir>${basedir}/../../..</main.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.thingsboard.common.transport</groupId>
            <artifactId>transport-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-tcnative-boringssl-static</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.11.1</version>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.14.1</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context-support</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>log4j-over-slf4j</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
            <version>3.0.1</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                <excludes>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$Builder.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$DataSet.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$DataSet$Builder.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$DataSet$DataSetValue.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$DataSet$DataSetValue$Builder.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$DataSet$DataSetValue$DataSetValueExtension.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$DataSet$DataSetValue$DataSetValueExtension$Builder.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$DataSet$Row.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$DataSet$Row$Builder.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$MetaData.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$MetaData$Builder.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$Metric.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$Metric$Builder.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$Metric$MetricValueExtension.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$Metric$MetricValueExtension$Builder.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$PropertySet.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$PropertySet$Builder.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$PropertySetList.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$PropertySetList$Builder.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$PropertyValue.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$PropertyValue$Builder.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$PropertyValue$PropertyValueExtension.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$PropertyValue$PropertyValueExtension$Builder.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$Template.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$Template$Builder.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$Template$Parameter.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$Template$Parameter$Builder.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$Template$Parameter$ParameterValueExtension.class</exclude>
                    <exclude>org/thingsboard/server/gen/transport/mqtt/SparkplugBProto$Payload$Template$Parameter$ParameterValueExtension$Builder.class</exclude>
                </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
